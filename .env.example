# Copy this file to .env and fill in your values
# Never commit .env to git

# Get your key at https://openrouter.ai → Profile → Keys
OPENROUTER_API_KEY=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

# Whisper model size: tiny | base | small | medium
